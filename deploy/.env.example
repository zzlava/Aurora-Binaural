# Aurora Binaural — Environment Configuration Template (docs/plan.md Sections 10 & 11)
# Copy this file to deploy/.env and replace the placeholder API key before starting services.
# NEVER commit real secrets or production API keys to version control.

# Required: Bearer API key for HTTP API authentication (/v1/* endpoints)
AURORA_API_KEY=replace_with_random_32_byte_hex_token_do_not_use_in_prod

# Network binding (defaults to local loopback 127.0.0.1; use reverse proxy for remote HTTPS)
AURORA_HOST=127.0.0.1
AURORA_PORT=8000

# Persistent runtime paths (shared between api and worker in Docker Compose)
AURORA_DATA_DIR=/data/runtime
AURORA_DB_PATH=/data/runtime/aurora.db
AURORA_HRTF_DIR=/app/data/hrtf

# Upload & media limits
# Maximum upload size in bytes (default: 524288000 = 500 MiB)
AURORA_MAX_UPLOAD_BYTES=524288000
# Maximum input audio duration in seconds (default: 7200 = 2 hours)
AURORA_MAX_DURATION_SEC=7200

# Worker execution, lease, retry, and retention settings
# Maximum processing time per job attempt in seconds (default: 1800 = 30 minutes)
AURORA_JOB_TIMEOUT_SEC=1800
# Retention period (TTL) for uploaded assets and job results/reports in seconds (default: 86400 = 24 hours)
AURORA_RETENTION_SEC=86400
# Number of concurrent rendering slots per Worker process (default: 1)
AURORA_WORKER_CONCURRENCY=1
# Worker task lease duration in seconds (default: 30)
AURORA_LEASE_DURATION_SEC=30
# Worker lease renewal / heartbeat interval in seconds (default: 5)
AURORA_HEARTBEAT_INTERVAL_SEC=5
# Periodic expired asset/result cleanup interval in seconds (default: 60)
AURORA_CLEANUP_INTERVAL_SEC=60
# Worker queue polling interval in seconds (default: 0.15)
AURORA_WORKER_POLL_INTERVAL_SEC=0.15
# Maximum retry attempts after initial try (default: 2)
AURORA_MAX_RETRIES=2
# Strict FFmpeg >= 7.0 enforcement for M4A/AAC (0 = warn on <7, 1 = reject on <7)
AURORA_STRICT_FFMPEG=0
